# Copy to .env.local for local development, and set the same four in Vercel
# under Settings -> Environment Variables. Never commit real values.

# Switches the app from the browser-local draft to the shared Google Sheet.
NEXT_PUBLIC_TRACKER_BACKEND=sheets

# The part of the sheet URL between /d/ and /edit
GOOGLE_SHEET_ID=

# From the service account JSON key: "client_email"
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# From the service account JSON key: "private_key".
# Paste it whole, including the BEGIN and END lines. Keeping the literal \n
# sequences is fine — the app converts them back to real newlines.
GOOGLE_PRIVATE_KEY=

# Optional. Defaults to the first tab in the spreadsheet.
GOOGLE_SHEET_TAB=
