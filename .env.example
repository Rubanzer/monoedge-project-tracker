# Copy to .env.local for local development, and set the same in Vercel under
# Settings -> Environment Variables. Never commit real values.

# Switches the app from the browser-local draft to the shared Google Sheet.
NEXT_PUBLIC_TRACKER_BACKEND=sheets

# The part of the sheet URL between /d/ and /edit
GOOGLE_SHEET_ID=

# Optional. Defaults to the first tab in the spreadsheet.
GOOGLE_SHEET_TAB=


# ---------------------------------------------------------------------------
# Authentication. Pick ONE. Federation is preferred and wins if both are set.
# ---------------------------------------------------------------------------

# --- A. Workload identity federation (no key exists) ---
# Vercel mints a short-lived OIDC token per deployment and Google trades it
# for an access token. Nothing to leak, nothing to rotate. All four required.
# Values come from the Google Cloud console, see the README.
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_SERVICE_ACCOUNT_EMAIL=

# Locally this also needs a Vercel OIDC token:
#   vercel link && vercel env pull
# The token is short-lived — pull it again when it expires.


# --- B. Service account key (fallback) ---
# A permanent credential that works from anywhere until revoked. Many Google
# Workspace orgs block key creation outright via org policy. Prefer A.
# Fill these with: npm run setup:key -- path/to/key.json
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=


# ---------------------------------------------------------------------------
# Sign-in. Google is the only connection, and only Google Workspace accounts
# on our own domain get in. Anyone MonoEdge issues an account to can sign in;
# there is no separate invite list to keep in step. See auth.ts.
# ---------------------------------------------------------------------------

# Google Cloud console -> APIs & Services -> Credentials -> Create OAuth
# client ID -> type "Web application".
#
# Set the OAuth consent screen to INTERNAL. That makes Google itself turn
# away anyone outside the Workspace, before a line of our code runs.
#
# Authorised redirect URIs must include, exactly:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-vercel-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Generate one with: npx auth secret
AUTH_SECRET=

# Only needed if the Workspace domain is ever not monoedge.in.
# AUTH_ALLOWED_DOMAIN=monoedge.in

# Roles and profiles live in a "Team" tab in the same spreadsheet. Create it
# by hand with these headers in row 1:
#   Email | Member ID | Name | Initials | Colour | Role | Active | First Seen | Last Seen
# A new joiner is appended there on first sign-in, as a developer. Promote by
# setting Role to admin; revoke by setting Active to FALSE.
